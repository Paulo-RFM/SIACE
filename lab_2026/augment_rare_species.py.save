import os
import random
from pathlib import Path
import pandas as pd
from PIL import Image, ImageOps, ImageEnhance
import numpy as np

# ======================================
# CONFIGURAÇÕES
# ======================================

csv_path   = "/home/paulomaciel/proj/species_crops/species_labels.csv"
input_dir  = "/home/paulomaciel/proj/species_crops/"
output_dir = "/home/paulomaciel/proj/species_crops_balanced/"
os.makedirs(output_dir, exist_ok=True)

# quantidade desejada por classe APÓS balanceamento
target_counts = {
    1: 1200,
    2: 800,
    3: 800,    # << classe extremamente rara → aumentar muito
    4: 800,
    5: 800,
    6: 800     # << classe extremamente rara → aumentar muito
}

# ======================================
# AUGMENTATIONS
# ======================================

def augment(img):
    """Aplica uma augmentation aleatória."""
    choice = random.choice(["flip_h", "flip_v", "rotate", "color", "crop"])
    
    if choice == "flip_h":
        return img.transpose(Image.FLIP_LEFT_RIGHT)
    
    if choice == "flip_v":
        return img.transpose(Image.FLIP_TOP_BOTTOM)
    
    if choice == "rotate":
        angle = random.choice([90, 180, 270])
        return img.rotate(angle, expand=False)
    
    if choice == "color":
        enhancer = ImageEnhance.Color(img)
        return enhancer.enhance(random.uniform(0.5, 1.5))
    
    if choice == "crop":
        w, h = img.size
        pad = int(min(w, h) * 0.05)
        img = img.crop((pad, pad, w-pad, h-pad))
        return img.resize((w, h), Image.BILINEAR)

    return img

# ======================================
# EXECUÇÃO
# ======================================

df = pd.read_csv(csv_path)
new_rows = []

print("\nAumentando classes raras...\n")

for species, target in target_counts.items():
    subset = df[df["label"] == species]
    current = len(subset)

    print(f"Classe {species}: {current} → {target}")

    if current >= target:
        # já tem exemplos suficientes
        for _, row in subset.iterrows():
            new_rows.append(row)
        continue

    # copiar exemplos originais
    for _, row in subset.iterrows():
        new_rows.append(row)

    # gerar augmentations até atingir target
    needed = target - current

    for i in range(needed):
        row = subset.sample(1).iloc[0]
        img = Image.open(row["crop_path"]).convert("RGB")

        aug_img = augment(img)

        new_name = f"{row['image']}_aug_{row['instance_id']}_{i}.png"
        new_path = os.path.join(output_dir, new_name)
        aug_img.save(new_path)

        new_rows.append({
            "image": row["image"],
            "instance_id": row["instance_id"],
            "crop_path": new_path,
            "label": species
        })

# salvar novo CSV
out_csv = os.path.join(output_dir, "species_labels_balanced.csv")
pd.DataFrame(new_rows).to_csv(out_csv, index=False)

print("\n✔ Balanceamento 
